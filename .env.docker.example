# Copy to `.env` and adjust before `docker compose up`.

# Host port mappings
WEB_API_PORT=8765
WEB_PORT=3000

# web-api
RUST_LOG=info
# Defaults to http://localhost:${WEB_PORT}. Override to allow extra origins
# (comma-separated), e.g. http://localhost:3100,http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Nuxt → web-api (must be reachable from the browser, not just from `web`)
NUXT_PUBLIC_PIXIEKIT_API_URL=http://localhost:8765
